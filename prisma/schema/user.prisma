enum Role {
    USER
    AUTHOR
    VET
    ADMIN
    SUPERADMIN
}

model User {
    id       String  @id @default(uuid())
    name     String
    email    String  @unique
    phone    String?
    password String
    role     Role    @default(USER)

    interestedSpeciesId String?
    interestedSpecies   PetSpecies? @relation(fields: [interestedSpeciesId], references: [id], onDelete: SetNull)

    interestedBreedId String?
    interestedBreed   PetBreed? @relation(fields: [interestedBreedId], references: [id], onDelete: SetNull)

    resetPasswordToken   String?
    resetPasswordExpires DateTime?

    profile Profile?
    session Session[]
    visitor Visitor?

    // Guide & Media Relations
    authoredGuides Guide[]         @relation("GuideAuthor")
    reviewedGuides Guide[]         @relation("GuideReviewer")
    guideBookmarks GuideBookmark[]
    guideLikes     GuideLike[]
    uploadedMedia  MediaAsset[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Profile {
    id String @id @default(uuid())

    bio            String?
    avatar         String?
    specialization String?
    address        String?
    city           String
    country        String
    zipCode        String?

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
